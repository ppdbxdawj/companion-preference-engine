{
  "name": "@companion-preference/reference-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --external @companion-preference/contracts --external @companion-preference/runtime-client",
    "test": "vitest run --root ../.. apps/reference-host/src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@companion-preference/contracts": "workspace:*",
    "@companion-preference/runtime-client": "workspace:*"
  }
}
